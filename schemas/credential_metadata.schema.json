{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElevenLabs Credential Metadata",
  "description": "Contains metadata only. Never store API secret here.",
  "type": "object",
  "required": [
    "credential_id",
    "label",
    "secret_ref",
    "workspace_group",
    "enabled",
    "priority",
    "health"
  ],
  "properties": {
    "credential_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "secret_ref": {
      "type": "string"
    },
    "workspace_group": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "priority": {
      "type": "integer"
    },
    "health": {
      "enum": [
        "unknown",
        "healthy",
        "degraded",
        "cooldown",
        "disabled"
      ]
    },
    "allowed_models": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_voice_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "soft_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "hard_limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "local_usage": {
      "type": "integer",
      "minimum": 0
    },
    "active_requests": {
      "type": "integer",
      "minimum": 0
    },
    "cooldown_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
